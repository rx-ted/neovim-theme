# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored and never pushed; this template is committed.
#
# Fields used by the config:
#
# LOCAL_IP             Local machine IP (e.g. localhost / 127.0.0.1)
# LOCAL_NAME           Local machine hostname (informational)
# REMOTE_IP            Remote/SSH server IP used for Tailscale preview URLs
# MARKDOWN_PREVIEW_PORT  Port for markdown-preview.nvim (default 8000)
# PYTHON_HOST_PROG     Absolute path to the python3 interpreter nvim uses
LOCAL_IP=localhost
LOCAL_NAME=
REMOTE_IP=xxx.xxx.xxx.xxx
MARKDOWN_PREVIEW_PORT=8000
PYTHON_HOST_PROG=/opt/homebrew/bin/python3.10